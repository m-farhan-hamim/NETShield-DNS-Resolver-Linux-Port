[Unit]
Description=NetShield DNS Resolver (DNS sinkhole / ad and tracker blocker)
Documentation=man:netshield(1)
After=network.target
Before=nss-lookup.target
Wants=nss-lookup.target

[Service]
Type=simple
User=netshield
Group=netshield
ExecStart=/usr/bin/java -Xms16m -Xmx256m -XX:+UseSerialGC -XX:-UsePerfData -cp /usr/share/netshield-dns/netshield-dns.jar com.psbdx.netshield.Daemon --config /etc/netshield/netshield.conf
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

# Runtime directories (owned by the netshield user, created by systemd)
StateDirectory=netshield
StateDirectoryMode=0750
LogsDirectory=netshield
LogsDirectoryMode=0750
RuntimeDirectory=netshield
RuntimeDirectoryMode=0750
UMask=0027

# Allow binding port 53 if the admin configures it; nothing else privileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening (no MemoryDenyWriteExecute: the JVM's JIT needs writable+executable memory)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
